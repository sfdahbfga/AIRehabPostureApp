<?xml version="1.0" encoding="utf-8"?>
<!-- 상단 스크롤 콘텐츠 + 하단 고정 Bottom Navigation (07_Home과 동일 구조) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/exerciseListRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical"
    tools:context=".ExerciseListActivity">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_padding_horizontal"
            android:paddingTop="16dp"
            android:paddingEnd="@dimen/screen_padding_horizontal"
            android:paddingBottom="24dp">

            <!-- 상단: 뒤로가기 + 제목 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/backButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="-12dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/back"
                    android:src="@drawable/ic_arrow_back" />

                <TextView
                    android:id="@+id/exerciseListTitleText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="@string/exercise_list_title"
                    android:textColor="@color/gray_dark"
                    android:textSize="24sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- 검색창 -->
            <EditText
                android:id="@+id/exerciseSearchEditText"
                android:layout_width="match_parent"
                android:layout_height="@dimen/input_height"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_input"
                android:drawablePadding="8dp"
                android:hint="@string/exercise_search_hint"
                android:imeOptions="actionSearch"
                android:importantForAutofill="no"
                android:inputType="text"
                android:paddingStart="12dp"
                android:paddingEnd="16dp"
                android:textColor="@color/gray_dark"
                android:textColorHint="@color/gray"
                android:textSize="15sp"
                app:drawableStartCompat="@drawable/ic_search" />

            <!-- 신체 부위 필터 (단일 선택), tag = 필터 키 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/filterAllButton"
                    style="@style/OptionButton"
                    android:tag="all"
                    android:text="@string/filter_all" />

                <TextView
                    android:id="@+id/filterNeckButton"
                    style="@style/OptionButton"
                    android:layout_marginStart="6dp"
                    android:tag="neck"
                    android:text="@string/neck" />

                <TextView
                    android:id="@+id/filterShoulderButton"
                    style="@style/OptionButton"
                    android:layout_marginStart="6dp"
                    android:tag="shoulder"
                    android:text="@string/shoulder" />

                <TextView
                    android:id="@+id/filterBackButton"
                    style="@style/OptionButton"
                    android:layout_marginStart="6dp"
                    android:tag="waist"
                    android:text="@string/waist" />

                <TextView
                    android:id="@+id/filterKneeButton"
                    style="@style/OptionButton"
                    android:layout_marginStart="6dp"
                    android:tag="knee"
                    android:text="@string/knee" />
            </LinearLayout>

            <!-- 목적 / 난이도 필터 (누르면 선택 메뉴 표시) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/purposeFilterButton"
                    style="@style/OptionButton"
                    android:paddingStart="12dp"
                    android:paddingEnd="8dp"
                    app:drawableEndCompat="@drawable/ic_arrow_drop_down"
                    app:drawableTint="@color/option_button_text"
                    tools:text="목적: 전체" />

                <TextView
                    android:id="@+id/difficultyFilterButton"
                    style="@style/OptionButton"
                    android:layout_marginStart="8dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="8dp"
                    app:drawableEndCompat="@drawable/ic_arrow_drop_down"
                    app:drawableTint="@color/option_button_text"
                    tools:text="난이도: 전체" />
            </LinearLayout>

            <!-- 운동 목록 (각 Card 위 12dp: 일부가 숨겨져도 간격 일정) -->
            <LinearLayout
                android:id="@+id/exerciseListContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical">

                <!-- 운동 1 -->
                <LinearLayout
                    android:id="@+id/exerciseCard1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_card"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/exerciseNameText1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/list_exercise1_name"
                        android:textColor="@color/gray_dark"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="72dp"
                            android:layout_height="wrap_content"
                            android:text="@string/exercise_purpose"
                            android:textColor="@color/gray"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/exercisePurposeText1"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/list_exercise1_purpose"
                            android:textColor="@color/gray_dark"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="72dp"
                            android:layout_height="wrap_content"
                            android:text="@string/exercise_difficulty"
                            android:textColor="@color/gray"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/exerciseDifficultyText1"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/list_exercise1_difficulty"
                            android:textColor="@color/gray_dark"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="72dp"
                            android:layout_height="wrap_content"
                            android:text="@string/exercise_duration"
                            android:textColor="@color/gray"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/exerciseDurationText1"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/list_exercise1_duration"
                            android:textColor="@color/gray_dark"
                            android:textSize="13sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- 운동 2 -->
                <LinearLayout
                    android:id="@+id/exerciseCard2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_card"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/exerciseNameText2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/list_exercise2_name"
                        android:textColor="@color/gray_dark"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="72dp"
                            android:layout_height="wrap_content"
                            android:text="@string/exercise_purpose"
                            android:textColor="@color/gray"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/exercisePurposeText2"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/list_exercise2_purpose"
                            android:textColor="@color/gray_dark"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="72dp"
                            android:layout_height="wrap_content"
                            android:text="@string/exercise_difficulty"
                            android:textColor="@color/gray"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/exerciseDifficultyText2"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/list_exercise2_difficulty"
                            android:textColor="@color/gray_dark"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="72dp"
                            android:layout_height="wrap_content"
                            android:text="@string/exercise_duration"
                            android:textColor="@color/gray"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/exerciseDurationText2"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/list_exercise2_duration"
                            android:textColor="@color/gray_dark"
                            android:textSize="13sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- 운동 3 -->
                <LinearLayout
                    android:id="@+id/exerciseCard3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_card"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/exerciseNameText3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/list_exercise3_name"
                        android:textColor="@color/gray_dark"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="72dp"
                            android:layout_height="wrap_content"
                            android:text="@string/exercise_purpose"
                            android:textColor="@color/gray"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/exercisePurposeText3"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/list_exercise3_purpose"
                            android:textColor="@color/gray_dark"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="72dp"
                            android:layout_height="wrap_content"
                            android:text="@string/exercise_difficulty"
                            android:textColor="@color/gray"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/exerciseDifficultyText3"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/list_exercise3_difficulty"
                            android:textColor="@color/gray_dark"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="72dp"
                            android:layout_height="wrap_content"
                            android:text="@string/exercise_duration"
                            android:textColor="@color/gray"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/exerciseDurationText3"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/list_exercise3_duration"
                            android:textColor="@color/gray_dark"
                            android:textSize="13sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- 운동 4 -->
                <LinearLayout
                    android:id="@+id/exerciseCard4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_card"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/exerciseNameText4"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/list_exercise4_name"
                        android:textColor="@color/gray_dark"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="72dp"
                            android:layout_height="wrap_content"
                            android:text="@string/exercise_purpose"
                            android:textColor="@color/gray"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/exercisePurposeText4"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/list_exercise4_purpose"
                            android:textColor="@color/gray_dark"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="72dp"
                            android:layout_height="wrap_content"
                            android:text="@string/exercise_difficulty"
                            android:textColor="@color/gray"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/exerciseDifficultyText4"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/list_exercise4_difficulty"
                            android:textColor="@color/gray_dark"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="72dp"
                            android:layout_height="wrap_content"
                            android:text="@string/exercise_duration"
                            android:textColor="@color/gray"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/exerciseDurationText4"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/list_exercise4_duration"
                            android:textColor="@color/gray_dark"
                            android:textSize="13sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- 필터 결과가 없을 때 표시 -->
            <TextView
                android:id="@+id/exerciseListEmptyText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:gravity="center"
                android:text="@string/exercise_list_empty"
                android:textColor="@color/gray"
                android:textSize="14sp"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>

    <!-- Bottom Navigation (구분선 + 4개 메뉴) -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/gray_light" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@color/white"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/bottomNavHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:drawablePadding="4dp"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/nav_home"
            android:textColor="@color/bottom_nav_item"
            android:textSize="12sp"
            app:drawableTint="@color/bottom_nav_item"
            app:drawableTopCompat="@drawable/ic_nav_home" />

        <TextView
            android:id="@+id/bottomNavExercise"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:drawablePadding="4dp"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/nav_exercise"
            android:textColor="@color/bottom_nav_item"
            android:textSize="12sp"
            app:drawableTint="@color/bottom_nav_item"
            app:drawableTopCompat="@drawable/ic_nav_exercise" />

        <TextView
            android:id="@+id/bottomNavRecord"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:drawablePadding="4dp"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/nav_record"
            android:textColor="@color/bottom_nav_item"
            android:textSize="12sp"
            app:drawableTint="@color/bottom_nav_item"
            app:drawableTopCompat="@drawable/ic_nav_record" />

        <TextView
            android:id="@+id/bottomNavMyPage"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:drawablePadding="4dp"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/nav_my_page"
            android:textColor="@color/bottom_nav_item"
            android:textSize="12sp"
            app:drawableTint="@color/bottom_nav_item"
            app:drawableTopCompat="@drawable/ic_nav_my_page" />
    </LinearLayout>
</LinearLayout>

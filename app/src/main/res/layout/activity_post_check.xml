<?xml version="1.0" encoding="utf-8"?>
<!-- 작은 화면/키보드 표시 시 스크롤 가능하도록 ScrollView 사용 (11_PreCheck와 같은 구조) -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/postCheckRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:fillViewport="true"
    tools:context=".PostCheckActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_padding_horizontal"
        android:paddingTop="16dp"
        android:paddingEnd="@dimen/screen_padding_horizontal"
        android:paddingBottom="32dp">

        <!-- 상단: 뒤로가기 + 제목 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/backButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="-12dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/back"
                android:src="@drawable/ic_arrow_back" />

            <TextView
                android:id="@+id/postCheckTitleText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="@string/post_check_title"
                android:textColor="@color/gray_dark"
                android:textSize="24sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 불편감 정도: Slider 대신 0~10 독립 숫자 버튼 (05 / 11과 같은 공통 레이아웃) -->
        <TextView
            android:id="@+id/discomfortQuestionText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/post_check_discomfort_question"
            android:textColor="@color/gray_dark"
            android:textSize="16sp"
            android:textStyle="bold" />

        <include
            android:id="@+id/discomfortButtonGroup"
            layout="@layout/layout_discomfort_buttons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp" />

        <!-- 오늘의 몸 상태 (단일 선택, 아이콘 + 라벨), tag = 저장용 키 -->
        <TextView
            android:id="@+id/conditionQuestionText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="@string/post_check_condition_question"
            android:textColor="@color/gray_dark"
            android:textSize="16sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/conditionGoodButton"
                style="@style/OptionButton"
                android:layout_height="80dp"
                android:drawablePadding="6dp"
                android:paddingTop="12dp"
                android:paddingBottom="8dp"
                android:tag="good"
                android:text="@string/condition_good"
                app:drawableTint="@color/option_button_text"
                app:drawableTopCompat="@drawable/ic_condition_good" />

            <TextView
                android:id="@+id/conditionNormalButton"
                style="@style/OptionButton"
                android:layout_height="80dp"
                android:layout_marginStart="8dp"
                android:drawablePadding="6dp"
                android:paddingTop="12dp"
                android:paddingBottom="8dp"
                android:tag="normal"
                android:text="@string/condition_normal"
                app:drawableTint="@color/option_button_text"
                app:drawableTopCompat="@drawable/ic_condition_normal" />

            <TextView
                android:id="@+id/conditionBadButton"
                style="@style/OptionButton"
                android:layout_height="80dp"
                android:layout_marginStart="8dp"
                android:drawablePadding="6dp"
                android:paddingTop="12dp"
                android:paddingBottom="8dp"
                android:tag="bad"
                android:text="@string/condition_bad"
                app:drawableTint="@color/option_button_text"
                app:drawableTopCompat="@drawable/ic_condition_bad" />
        </LinearLayout>

        <!-- 특이사항 (선택 입력) -->
        <TextView
            android:id="@+id/noteLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="@string/note_optional"
            android:textColor="@color/gray_dark"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/noteEditText"
            android:layout_width="match_parent"
            android:layout_height="96dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input"
            android:gravity="top|start"
            android:hint="@string/post_check_note_hint"
            android:importantForAutofill="no"
            android:inputType="textMultiLine"
            android:maxLength="200"
            android:padding="16dp"
            android:textColor="@color/gray_dark"
            android:textColorHint="@color/gray"
            android:textSize="15sp" />

        <!-- 내용이 짧을 때 다음 버튼을 화면 하단으로 밀어줌 -->
        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="32dp" />

        <!-- 다음 버튼 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/nextButton"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/next"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            app:backgroundTint="@color/primary"
            app:cornerRadius="@dimen/radius_default" />
    </LinearLayout>
</ScrollView>

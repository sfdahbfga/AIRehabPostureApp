<?xml version="1.0" encoding="utf-8"?>
<!-- 작은 화면에서 잘리지 않도록 ScrollView 사용 -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/bodyConditionRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:fillViewport="true"
    tools:context=".BodyConditionActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_padding_horizontal"
        android:paddingTop="16dp"
        android:paddingEnd="@dimen/screen_padding_horizontal"
        android:paddingBottom="32dp">

        <!-- 상단: 뒤로가기 + 제목 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/backButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="-12dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/back"
                android:src="@drawable/ic_arrow_back" />

            <TextView
                android:id="@+id/bodyConditionTitleText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="@string/body_condition_title"
                android:textColor="@color/gray_dark"
                android:textSize="24sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 안내 문구 -->
        <TextView
            android:id="@+id/bodyConditionDescriptionText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/body_condition_description"
            android:textColor="@color/gray"
            android:textSize="14sp" />

        <!-- 인체 실루엣 Placeholder -->
        <ImageView
            android:id="@+id/bodySilhouetteImage"
            android:layout_width="match_parent"
            android:layout_height="160dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_logo_placeholder"
            android:contentDescription="@string/body_silhouette_description"
            android:padding="16dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_body_placeholder" />

        <!-- 신체 부위 (복수 선택), tag = 저장용 키 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/neckButton"
                style="@style/OptionButton"
                android:tag="neck"
                android:text="@string/neck" />

            <TextView
                android:id="@+id/shoulderButton"
                style="@style/OptionButton"
                android:layout_marginStart="8dp"
                android:tag="shoulder"
                android:text="@string/shoulder" />

            <TextView
                android:id="@+id/elbowButton"
                style="@style/OptionButton"
                android:layout_marginStart="8dp"
                android:tag="elbow"
                android:text="@string/elbow" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/waistButton"
                style="@style/OptionButton"
                android:tag="waist"
                android:text="@string/waist" />

            <TextView
                android:id="@+id/kneeButton"
                style="@style/OptionButton"
                android:layout_marginStart="8dp"
                android:tag="knee"
                android:text="@string/knee" />

            <TextView
                android:id="@+id/ankleButton"
                style="@style/OptionButton"
                android:layout_marginStart="8dp"
                android:tag="ankle"
                android:text="@string/ankle" />
        </LinearLayout>

        <!-- 불편감 정도: Slider 대신 0~10 독립 숫자 버튼 (단일 선택) -->
        <TextView
            android:id="@+id/discomfortQuestionText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="@string/discomfort_question"
            android:textColor="@color/gray_dark"
            android:textSize="16sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            tools:ignore="HardcodedText">

            <TextView
                android:id="@+id/discomfortButton0"
                style="@style/OptionButton"
                android:text="0" />

            <TextView
                android:id="@+id/discomfortButton1"
                style="@style/OptionButton"
                android:layout_marginStart="6dp"
                android:text="1" />

            <TextView
                android:id="@+id/discomfortButton2"
                style="@style/OptionButton"
                android:layout_marginStart="6dp"
                android:text="2" />

            <TextView
                android:id="@+id/discomfortButton3"
                style="@style/OptionButton"
                android:layout_marginStart="6dp"
                android:text="3" />

            <TextView
                android:id="@+id/discomfortButton4"
                style="@style/OptionButton"
                android:layout_marginStart="6dp"
                android:text="4" />

            <TextView
                android:id="@+id/discomfortButton5"
                style="@style/OptionButton"
                android:layout_marginStart="6dp"
                android:text="5" />
        </LinearLayout>

        <!-- 두 번째 줄: 마지막 빈 칸(Space)으로 첫 줄과 버튼 크기를 맞춤 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal"
            tools:ignore="HardcodedText">

            <TextView
                android:id="@+id/discomfortButton6"
                style="@style/OptionButton"
                android:text="6" />

            <TextView
                android:id="@+id/discomfortButton7"
                style="@style/OptionButton"
                android:layout_marginStart="6dp"
                android:text="7" />

            <TextView
                android:id="@+id/discomfortButton8"
                style="@style/OptionButton"
                android:layout_marginStart="6dp"
                android:text="8" />

            <TextView
                android:id="@+id/discomfortButton9"
                style="@style/OptionButton"
                android:layout_marginStart="6dp"
                android:text="9" />

            <TextView
                android:id="@+id/discomfortButton10"
                style="@style/OptionButton"
                android:layout_marginStart="6dp"
                android:text="10" />

            <Space
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1" />
        </LinearLayout>

        <!-- 내용이 짧을 때 다음 버튼을 화면 하단으로 밀어줌 -->
        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="32dp" />

        <!-- 다음 버튼 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/nextButton"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/next"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            app:backgroundTint="@color/primary"
            app:cornerRadius="@dimen/radius_default" />
    </LinearLayout>
</ScrollView>

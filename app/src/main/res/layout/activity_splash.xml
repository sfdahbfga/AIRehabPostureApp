<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/splash_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".SplashActivity">

    <!-- 중앙: 로고 / 앱 이름 / 로딩 점 -->
    <LinearLayout
        android:id="@+id/splash_center_group"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- 로고: 아래 앱 이름 Text가 있으므로 접근성에서는 장식 이미지로 처리 -->
        <ImageView
            android:id="@+id/splash_logo"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter"
            android:src="@drawable/app_logo" />

        <TextView
            android:id="@+id/splash_app_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/splash_app_name_placeholder"
            android:textColor="@color/gray_dark"
            android:textSize="22sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/splash_loading_dots"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:contentDescription="@string/splash_loading_description"
            android:orientation="horizontal">

            <View
                android:id="@+id/splash_dot_1"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/bg_loading_dot" />

            <View
                android:id="@+id/splash_dot_2"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginStart="8dp"
                android:alpha="0.3"
                android:background="@drawable/bg_loading_dot" />

            <View
                android:id="@+id/splash_dot_3"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginStart="8dp"
                android:alpha="0.3"
                android:background="@drawable/bg_loading_dot" />
        </LinearLayout>
    </LinearLayout>

    <!-- 하단: Figma 초기 화면 하단 영역 Placeholder -->
    <TextView
        android:id="@+id/splash_footer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp"
        android:text="@string/splash_footer_placeholder"
        android:textColor="@color/gray_medium"
        android:textSize="12sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
